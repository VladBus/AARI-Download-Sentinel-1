# AARI-Download-Sentinel-1 configuration
# Copy this file to .env and enter your own CDSE S3 credentials.
# NEVER commit .env or publish either key.

# Copernicus Data Space Ecosystem — S3 credentials
CDSE_ACCESS_KEY=
CDSE_SECRET_KEY=

# S3 storage settings
CDSE_S3_ENDPOINT_URL=https://eodata.dataspace.copernicus.eu
CDSE_S3_BUCKET=eodata
CDSE_S3_REGION_NAME=default
# Prefix used by the lightweight Sentinel-1 EW S3 access check
CDSE_S3_CHECK_PREFIX=Sentinel-1/SAR/EW_GRDM_1S/

# CDSE OData product catalogue
CDSE_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products

# Sentinel-1 search settings
S1_REGION_GEOJSON=data/geometry/SMP.geojson
S1_BUFFER_METERS=150000
S1_PRODUCT_TYPE=EW_GRDM_1S
# DH in the Sentinel-1 product name means dual HH+HV polarization.
S1_POLARIZATION_CODE=DH

# Local folders (relative to the project root unless an absolute path is supplied)
S1_DOWNLOAD_DIR=data/downloads
S1_LOG_DIR=logs

# Informational only; this date does not authenticate requests.
CDSE_CREDENTIALS_EXPIRES_AT=2040-11-18T00:00:00
